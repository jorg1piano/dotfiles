#!/usr/bin/env bash
# Scan the focused pane's recent output, list the copyable things in it
# (URLs, branches, paths, SHAs, ...), and copy the pick to the clipboard.
# Bound to prefix+' as a popup command; see herdr/config.toml.
set -euo pipefail

LINES=${HERDR_PICK_LINES:-1000}
LOG=${HERDR_PICK_LOG:-${TMPDIR:-/tmp}/herdr-pick.log}

# The popup inherits a login-less PATH, so Homebrew's bin may be missing.
PATH=$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin

# The popup closes the moment we exit, so an error has to be held on screen.
# stdin is not always a terminal here, hence /dev/tty and the log fallback.
die() {
    printf 'herdr-pick: %s\n' "$*" | tee -a "$LOG" >&2
    if [ -e /dev/tty ]; then
        printf '\npress enter to close ' >&2
        read -r _ </dev/tty || true
    fi
    exit 1
}

trap 'status=$?; trap - ERR; die "failed at line $LINENO (exit $status)"' ERR

command -v fzf >/dev/null || die "fzf is not on PATH (brew install fzf)"
command -v jq >/dev/null || die "jq is not on PATH (brew install jq)"
[ "${HERDR_ENV:-}" = 1 ] || die "not running inside a Herdr pane"

# The popup is its own pane, so the source is the focused pane that is not us.
# HERDR_WORKSPACE_ID is not always exported into the popup; unfiltered still
# works because the jq below prefers the focused pane and our own tab anyway.
if [ -n "${HERDR_WORKSPACE_ID:-}" ]; then
    panes=$(herdr pane list --workspace "$HERDR_WORKSPACE_ID" 2>&1) ||
        die "herdr pane list failed: $panes"
else
    panes=$(herdr pane list 2>&1) || die "herdr pane list failed: $panes"
fi

source_pane=$(
    printf '%s' "$panes" |
        jq -r --arg own "${HERDR_PANE_ID:-}" --arg tab "${HERDR_TAB_ID:-}" '
            .result.panes as $all
            | [$all[] | select(.pane_id != $own)] as $others
            | ($others | map(select(.focused))) as $focused
            | ($others | map(select(.tab_id == $tab))) as $sibling
            | (($focused + $sibling + $others + $all)[0].pane_id // "")
        '
)
[ -n "$source_pane" ] || die "no other pane to read"

source_cwd=$(
    printf '%s' "$panes" |
        jq -r --arg id "$source_pane" '
            [.result.panes[] | select(.pane_id == $id)][0]
            | (.foreground_cwd // .cwd // "")
        '
)

text=$(herdr pane read "$source_pane" --source recent-unwrapped --lines "$LINES" --format text)

candidates=$(printf '%s' "$text" | perl -CS -0777 -ne '
    # TUIs like Claude Code hard-wrap a long path onto indented next lines,
    # which recent-unwrapped cannot undo. The wrap column differs per resize
    # and per block, so guess loosely: a line ending in a long or slashed
    # token, followed by an indented line that is no longer and starts with a
    # token char, continues on that line. Each run of such lines is a group.
    my @phys = split /\n/;
    my $cont = qr{^\s+[\w.@+/%=&?#~-]};
    my @groups;
    for my $i (0 .. $#phys) {
        my $p = $i ? $phys[$i - 1] : undef;
        if (defined $p && $p =~ /(\S+)$/ && ($1 =~ m{/} || length $1 >= 16)
            && $phys[$i] =~ $cont && length $phys[$i] <= length $p) {
            push @{ $groups[-1] }, $phys[$i];
        } else {
            push @groups, [$phys[$i]];
        }
    }

    my @pats = (
        ["url",    qr{(?:https?|ftp)://[^\s"'"'"'`<>()\[\]{}|\\]+}],
        ["branch", qr{\((?<m>[A-Za-z0-9._/+-]{1,60})\)\s*[\$#>%]}],
        ["branch", qr{^\s*\*\s+(?<m>[A-Za-z0-9._/+-]+)\s*$}],
        ["branch", qr{\bOn branch (?<m>\S+)}],
        ["email",  qr{[\w.+-]+\@[\w-]+\.[\w.-]*\w}],
        ["addr",   qr{\b(?:(?:\d{1,3}\.){3}\d{1,3}|localhost)(?::\d+)\b}],
        ["uuid",   qr{\b[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\b}],
        ["sha",    qr{\b[0-9a-f]{7,40}\b}],
        ["path",   qr{(?<![\w@/.~-])(?:~|\.{1,2})?/?[\w.@+-]+(?:/[\w.@+-]+)+/?}],
        ["hex",    qr{#[0-9a-fA-F]{6}\b}],
    );
    # Longest match wins an overlap, so a path keeps the uuid inside it.
    sub scan {
        my ($line) = @_;
        my (@hits, @found, @claimed);
        for my $p (@pats) {
            my ($kind, $re) = @$p;
            while ($line =~ /$re/g) {
                push @hits, [$kind, defined $+{m} ? $+{m} : $&, $-[0], $+[0]];
            }
        }
        for my $h (sort { ($b->[3] - $b->[2]) <=> ($a->[3] - $a->[2]) } @hits) {
            my ($kind, $val, $s, $e) = @$h;
            next if grep { $s < $_->[1] && $e > $_->[0] } @claimed;
            push @claimed, [$s, $e];
            $val =~ s/[.,;:!?)\]}>"'"'"']+$//;
            push @found, [$s, $kind, $val] if length($val) >= 3;
        }
        return map { [$_->[1], $_->[2]] } sort { $a->[0] <=> $b->[0] } @found;
    }
    my (@out, %seen);
    # Bottom-up: the most recent output is what you usually want.
    for my $g (reverse @groups) {
        my @found = scan(join "", $g->[0], map { s/^\s+//r } @$g[1 .. $#$g]);
        if (@$g > 1) {
            # The glue is a guess, so the unglued pieces stay on offer, but
            # not the ones that sit inside a glued token: those are cut-off
            # tails, never what you want.
            my @joined = map { $_->[1] } @found;
            push @found, grep {
                my $v = $_->[1];
                !grep { index($_, $v) > 0 } @joined;
            } map { scan($_) } @$g;
        }
        for (@found) {
            my ($kind, $val) = @$_;
            push @out, "$kind\t$val" unless $seen{$val}++;
        }
    }
    print "$_\n" for @out;
')
# `.iex.exs` binds its helpers as anonymous functions, so they are callable
# only as `name.(args)`. The file is the project's, not the pane's output, so
# the handles are offered whether or not an iex session has printed them.
iex_file=""
if [ -n "$source_cwd" ] && [ -d "$source_cwd" ]; then
    root=$(git -C "$source_cwd" rev-parse --show-toplevel 2>/dev/null) || root=$source_cwd
    for f in "$source_cwd/.iex.exs" $(find "$root" -maxdepth 2 -name .iex.exs 2>/dev/null); do
        if [ -f "$f" ]; then
            iex_file=$f
            break
        fi
    done
fi

if [ -n "$iex_file" ]; then
    handles=$(perl -ne '
        next unless /^\s*([a-z_][A-Za-z0-9_]*)\s*=\s*(\S.*?)\s*$/;
        my ($name, $rhs) = ($1, $2);
        my $call;
        if ($rhs =~ /^fn\s*(.*?)\s*->/) {
            my $args = $1;
            $args =~ s/\s+//g;
            $call = "$name.($args)";
        } elsif ($rhs =~ /^&/) {
            $call = "$name.()";
        } elsif (exists $bound{$rhs}) {
            # `geo_on = sim_on` rebinds an earlier handle under a new name.
            $call = $bound{$rhs};
            $call =~ s/^[^.]+/$name/;
        } else {
            next;
        }
        $bound{$name} = $call;
        print "iex\t$call\n";
    ' "$iex_file")
    candidates=$(printf '%s\n%s\n' "$candidates" "$handles" | sed '/^$/d')
fi

[ -n "$candidates" ] || die "nothing copyable found in $source_pane"

# fzf cuts a long line at the right edge, which hides the filename. Add a
# display column that cuts long values in the middle instead, keeping the
# last path segment whole when it fits. The kind column, border and pointer
# take about 16 columns. fzf 0.46 matches only what it shows, so the cut-out
# middle is not searchable.
cols=$({ stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2) || cols=""
width=$(( ${cols:-80} > 40 ? ${cols:-80} - 16 : 24 ))
rows=$(printf '%s\n' "$candidates" | perl -CS -F'\t' -lane '
    my ($kind, $val) = ($F[0], join "\t", @F[1 .. $#F]);
    my $w = '"$width"';
    my $show = $val;
    if (length $val > $w) {
        my $base = $val =~ m{(/[^/]+/?)$} ? length $1 : 0;
        my $tail = int($w * 0.6);
        $tail = $base if $base > $tail && $base <= $w - 8;
        $show = substr($val, 0, $w - 1 - $tail) . "\x{2026}" . substr($val, -$tail);
    }
    print "$kind\t$show\t$val";
')

picked=$(
    printf '%s\n' "$rows" |
        fzf --multi --exact --no-sort --height=100% --border \
            --delimiter='\t' --with-nth='1,2' --nth=1,2 \
            --prompt='copy > ' \
            --header="$source_pane — type a kind (url/branch/path/sha/iex/…) to narrow · enter: copy · ctrl-p: copy + paste into pane · tab: multi-select" \
            --expect=ctrl-p
) || exit 0

key=$(printf '%s\n' "$picked" | head -1)
values=$(printf '%s\n' "$picked" | tail -n +2 | cut -f3-)
[ -n "$values" ] || exit 0

printf '%s' "$values" | pbcopy
if [ "$key" = "ctrl-p" ]; then
    herdr pane send-text "$source_pane" "$values"
fi
exit 0
